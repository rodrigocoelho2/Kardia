@HostAddress = http://127.0.0.1:5091
@apiKey = devkey
# The id from GET /user/list
@userId = 00000000000000000000000000000000

### Profile
GET {{HostAddress}}/profile?userId={{userId}}
x-api-key: {{apiKey}}

### Save it
POST {{HostAddress}}/profile
x-api-key: {{apiKey}}
Content-Type: application/json

{ "userId": "{{userId}}", "birthDate": "1996-05-14", "sex": "Male", "heightCm": 180, "weightKg": 79, "maxHeartRate": null, "sleepNeedMinutes": 465 }
