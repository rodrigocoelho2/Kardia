@model Kardia.Website.Model.Account.AccountPageModel
@{
    var active = (string)ViewData["Tab"]!;
    var query = Model.ReturnUrl == "/" ? string.Empty : $"?returnUrl={Uri.EscapeDataString(Model.ReturnUrl)}";
}
@* Inside the form: the Sign in / Create account tabs (when anyone may create an account) and the messages. *@
@if (Model.CanCreateAccount && !Model.IsFirstAccount)
{
    <nav class="au-tabs" aria-label="Account">
        <a href="/sign-in@(query)" class="@(active == "sign-in" ? "on" : "")" aria-current="@(active == "sign-in" ? "page" : null)">Sign in</a>
        <a href="/create-account@(query)" class="@(active == "create" ? "on" : "")" aria-current="@(active == "create" ? "page" : null)">Create account</a>
    </nav>
}
@if (Model.Errors.Count > 0)
{
    <div class="au-error" role="alert">
        @foreach (var error in Model.Errors)
        {
            <p>@error</p>
        }
    </div>
}
else if (Model.Unavailable is not null)
{
    <div class="au-error" role="alert"><p>@Model.Unavailable</p></div>
}
