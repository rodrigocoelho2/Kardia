@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var antiforgeryToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var title = ViewData["Title"] as string;
    // The app follows Settings › Appearance; the public pages (landing, sign-in) are always dark.
    var theme = ViewData["Themed"] is true ? Kardia.Website.Helpers.Theme.Of(Context) : "dark";
}
<!doctype html>
<html lang="en" data-theme="@(theme == "light" ? "light" : "dark")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover" />
    <meta name="request-verification-token" content="@antiforgeryToken" />
    <meta name="color-scheme" content="@(theme == "light" ? "light" : theme == "system" ? "dark light" : "dark")" />
    <title>@(string.IsNullOrEmpty(title) || title == "Kardia" ? "Kardia" : $"{title} · Kardia")</title>
    <meta name="description" content="Kardia turns your Apple Watch data into recovery, sleep, strain and biological age. Self-hosted, on your phone and your computer." />
    <meta name="theme-color" content="@(theme == "light" ? "#F2F3F5" : "#0B0C0F")" data-theme-color />
    @if (theme == "system")
    {
        @* Follow the device: pick before the first paint, and again when it changes. *@
        <script>
            (function () {
                var media = window.matchMedia("(prefers-color-scheme: light)");
                var apply = function () {
                    var light = media.matches;
                    document.documentElement.setAttribute("data-theme", light ? "light" : "dark");
                    var meta = document.querySelector("meta[data-theme-color]");
                    if (meta) meta.setAttribute("content", light ? "#F2F3F5" : "#0B0C0F");
                };
                apply();
                if (media.addEventListener) media.addEventListener("change", apply);
            })();
        </script>
    }
    <meta name="application-name" content="Kardia" />
    <meta name="apple-mobile-web-app-title" content="Kardia" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="icon" href="~/img/kardia.svg" type="image/svg+xml" />
    <link rel="icon" href="~/img/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="~/img/apple-touch-icon.png" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="preload" href="~/fonts/manrope-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/manrope-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    @if (ViewData["Themed"] is true)
    {
        @* Pages are fetched as soon as a finger lands on a link (Chrome, Edge, Android), so they open at once. *@
        <script type="speculationrules">
            { "prefetch": [ { "where": { "and": [ { "href_matches": "/*" }, { "not": { "href_matches": "/about" } }, { "not": { "selector_matches": "[data-no-prefetch]" } } ] }, "eagerness": "moderate" } ] }
        </script>
    }
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    @RenderBody()
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
