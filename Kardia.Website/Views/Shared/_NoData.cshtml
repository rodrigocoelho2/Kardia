@model AppPageModel
@* Shown when nothing was synced for the day. *@
<section class="card empty rise">
    <span class="ico-chip rec">@Icons.Get("watch")</span>
    <h2>@(Model.IsToday ? "Nothing from your Apple Watch yet today" : $"No Apple Watch data for {Fmt.ShortDate(Model.Date)}")</h2>
    <p>Kardia works from what your Apple Watch records: sleep, heart rate, HRV and workouts. Connect Health Auto Export (or the Kardia Shortcut) once and every sync lands here.</p>
    <a class="btn rec" href="/settings#apple-watch">@Icons.Get("sync")Connect Apple Watch</a>
</section>
