@model AiCardModel
@* The AI coach for this screen. Hidden until /coach/state says a provider is set up (wwwroot/js/app.js fills it). *@
<section class="card ai-card rise" data-ai-card data-topic="@Model.Topic" data-date="@(Model.Date is { } d ? Fmt.Iso(d) : "")" hidden aria-live="polite">
    <div class="ai-top">
        <span class="coach-ico">@Icons.Get("sparkle")</span>
        <div class="grow">
            <span class="kicker" style="color:var(--slp-text)">AI coach</span>
            <b class="ai-headline" data-ai-headline>@Model.Prompt</b>
        </div>
        <button class="btn slp small" type="button" data-ai-go>@Icons.Get("sparkle")<span data-label>Ask AI</span></button>
    </div>
    <div class="ai-wait" data-ai-wait hidden>
        <div class="ai-pulse" aria-hidden="true"><i></i><i></i><i></i></div>
        <p class="muted small-note">Reading your numbers… a local model can take a minute or two.</p>
    </div>
    <p class="alert err" data-ai-error hidden></p>
    <div data-ai-body hidden>
        <p class="ai-summary" data-ai-summary></p>
        <ol class="steps" data-ai-actions></ol>
        <details class="ai-more" data-ai-more hidden>
            <summary>Going well and what to watch</summary>
            <ul class="tips" data-ai-lists></ul>
        </details>
        <small class="dim" data-ai-meta></small>
    </div>
</section>
