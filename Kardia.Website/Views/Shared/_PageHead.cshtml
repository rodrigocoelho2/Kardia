@model AppPageModel
@{
    var title = (string)ViewData["Title"]!;
}
@* The header of the Recovery, Sleep and Strain pages: the day, the title and the day picker. *@
<header class="head rise">
    <div>
        <div class="eyebrow">@Fmt.LongDate(Model.Date)</div>
        <h1>@title</h1>
    </div>
    <div class="head-acts">
        <partial name="_DateNav" model="Model" />
    </div>
</header>
