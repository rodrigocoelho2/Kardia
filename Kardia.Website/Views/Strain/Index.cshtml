@model Kardia.Website.Model.Days.DayPageModel
@{
    Layout = "_App";
    ViewData["Title"] = "Strain";
    var day = Model.Day;
    var strain = day.Strain;
    var sleep = day.Sleep;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var tip = day.Coach.FirstOrDefault(static t => t.Area == CoachArea.Strain);
    var zoneNames = new[] { "Warm-up", "Easy", "Aerobic", "Threshold", "Max" };
    var zoneRanges = new[] { "50–60%", "60–70%", "70–80%", "80–90%", "90%+" };
    var zoneColours = new[] { "var(--sky)", "var(--rec)", "var(--mid)", "var(--str)", "var(--str-2)" };
    var zoneTotal = Math.Max(1, strain.ZoneMinutes.Sum());
    var week = day.Recent.TakeLast(7).ToList();
    var weekStrains = week.Select(static w => w.Strain ?? 0).ToList();
    var weekAverage = weekStrains.Count > 0 ? weekStrains.Average() : 0;
    var best = strain.Workouts.MaxBy(static w => w.Strain ?? 0);
}

<partial name="_PageHead" model="Model" />
<partial name="_WeekStrip" model="Model" />

@if (!day.HasData)
{
    <partial name="_NoData" model="Model" />
}
else
{
    <div class="row">
        <section class="card hero tint-str rise" style="--d:1">
            <div class="ambient" aria-hidden="true" style="--amb: rgba(255,138,71,0.2)"></div>
            <div class="ring-box">
                @Charts.Ring((strain.Score ?? 0) / 21, "str", (strain.TargetLow / 21, strain.TargetHigh / 21))
                <div class="center">
                    <span class="big num">@Fmt.One(strain.Score)</span>
                    <span class="lbl">Strain</span>
                </div>
            </div>
            <h2 style="font-size:22px;color:var(--str-3)">Target @Fmt.One(strain.TargetLow) – @Fmt.One(strain.TargetHigh)</h2>
            <p class="lead">@(tip?.Text ?? "Strain is the load on your heart, from 0 to 21. Every minute above half your maximum heart rate adds to it, more in the higher zones.")</p>
            <div class="tiles t3" style="align-self:stretch">
                <div class="tile center"><span class="k">Calories</span><span class="v">@Fmt.Whole(strain.TotalKcal)</span></div>
                <div class="tile center"><span class="k">Active</span><span class="v">@Fmt.Whole(strain.ActiveKcal)</span></div>
                <div class="tile center"><span class="k">Steps</span><span class="v">@Fmt.Whole(strain.Steps)</span></div>
            </div>
        </section>

        <section class="card w2 rise" style="--d:2">
            <div class="card-head">
                <h2>Heart rate zones</h2>
                <span class="side-note">max @strain.MaxHeartRate bpm</span>
            </div>
            <div class="zones5" aria-hidden="true">
                @for (var z = 0; z < 5; z++)
                {
                    if (strain.ZoneMinutes[z] > 0)
                    {
                        <i class="z@(z + 1)" style="flex:@strain.ZoneMinutes[z]"></i>
                    }
                }
            </div>
            @for (var z = 4; z >= 0; z--)
            {
                var minutes = strain.ZoneMinutes[z];
                <div class="list-row">
                    <span class="ico-chip" style="--chip-bg:transparent"><i class="swatch z@(z + 1)" style="width:14px;height:14px;border-radius:5px"></i></span>
                    <div class="grow">
                        <span class="top"><span>Zone @(z + 1) · @zoneNames[z] <small class="dim" style="font-weight:400">@zoneRanges[z] · @((strain.MaxHeartRate * (0.5 + z * 0.1)).ToString("0"))+ bpm</small></span><span class="num">@Fmt.Duration(minutes)</span></span>
                        <div class="meter" style="--fill:@zoneColours[z]"><i style="width:@((minutes * 100.0 / zoneTotal).ToString("0.0", inv))%"></i></div>
                    </div>
                </div>
            }
        </section>
    </div>

        var load = day.CardioLoad;
        // The scale runs from 0.5 to 1.8: detraining below 0.8, maintaining to 1.0, productive to 1.3, overreaching to 1.5.
        double ScaleAt(double ratio) => Math.Clamp((ratio - 0.5) / 1.3 * 100, 0, 100);
        var history = load.History.Select(static p => new Charts.SeriesPoint(p.Date, p.Value)).ToList();
    <partial name="_AiCard" model='new AiCardModel(AiCoachTopic.Strain, Model.IsToday ? null : Model.Date, "How hard should I go?")' />
    <div class="row">
        <section class="card rise" style="--d:3" id="cardio-load">
            <div class="card-head">
                <h2>Cardio load</h2>
                <span class="side-note">last 7 days vs. last 28</span>
            </div>
            @if (load.Ready && load.Ratio is { } ratio)
            {
                <div style="display:flex;align-items:baseline;gap:12px">
                    <span class="cl-ratio num" style="color:@Fmt.CardioColor(load.Status)">@ratio.ToString("0.00", inv)</span>
                    <b style="font:600 18px var(--font-display);color:@Fmt.CardioColor(load.Status)">@Fmt.CardioName(load.Status)</b>
                </div>
                <div class="cl-scale" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><span class="mark" style="left:@(ScaleAt(ratio).ToString("0.0", inv))%"></span></div>
                <div class="cl-labels" aria-hidden="true"><span>Detraining</span><span>Maintain</span><span>Productive</span><span>Over&shy;reaching</span><span>Over&shy;training</span></div>
                <p class="muted" style="font-size:14px">@Fmt.CardioText(load.Status)</p>
                @if (load.StrainLow is { } low && load.StrainHigh is { } high)
                {
                    <div class="tiles">
                        <div class="tile"><span class="k">Productive strain</span><span class="v">@Fmt.One(low)–@Fmt.One(high)<small> a day</small></span></div>
                        <div class="tile"><span class="k">Heart load</span><span class="v">@load.AcuteLoad.ToString("0", inv)<small> vs @load.ChronicLoad.ToString("0", inv) usual</small></span></div>
                    </div>
                }
            }
            else
            {
                <p class="muted" style="font-size:14px">@Fmt.CardioText(load.Status)</p>
            }
        </section>

        <section class="card w2 rise" style="--d:3">
            <div class="card-head">
                <h2>Cardio load · 8 weeks</h2>
                <div class="legend">
                    <span><i class="swatch" style="background:var(--rec)"></i>Productive 1.0–1.3</span>
                </div>
            </div>
            @{
                var banded = history.Select(static p => p with { Low = 1.0, High = 1.3, Status = p.Value is { } v ? (v > 1.5 ? "far" : v > 1.3 ? "out" : null) : null }).ToList();
            }
            <div class="chart-wide">@Charts.Series(banded, "ser-str", "Cardio load ratio over the last eight weeks", 1, 640, 210)</div>
            <div class="chart-narrow">@Charts.Series(banded, "ser-str", "Cardio load ratio over the last eight weeks", 1, 360, 160)</div>
        </section>
    </div>

    <div class="row">
        <section class="card w2 rise" style="--d:3">
            <div class="card-head">
                <h2>Heart rate</h2>
                <span class="side-note">@strain.MinBpm–@strain.MaxBpm bpm · average @(strain.AvgBpm?.ToString() ?? "—")</span>
            </div>
            @{
                var wake = sleep.BedEnd?.Date == Model.Date.ToDateTime(TimeOnly.MinValue) ? sleep.BedEnd : null;
                var heartLabel = $"Heart rate through the day, between {strain.MinBpm} and {strain.MaxBpm} bpm";
            }
            <div class="chart-wide">@Charts.DayHeart(Model.Date, day.HeartRates, wake, strain.Workouts, Model.IsToday ? Clock.Now : null, heartLabel, 640)</div>
            <div class="chart-narrow">@Charts.DayHeart(Model.Date, day.HeartRates, wake, strain.Workouts, Model.IsToday ? Clock.Now : null, heartLabel)</div>
            <div class="card-head" style="margin-top:6px">
                <h2>Last 7 days</h2>
                <span class="side-note">average @Fmt.One(weekAverage)</span>
            </div>
            <div class="week-bars">
                <span class="avg" style="bottom:calc(@((weekAverage / 21 * 100).ToString("0.0", inv))% * 0.7 + 24px)"></span>
                @for (var i = 0; i < week.Count; i++)
                {
                    var item = week[i];
                    <div class="col @(item.Date == Model.Date ? "on" : "")">
                        <span class="num" style="color:var(--text-2)">@Fmt.One(item.Strain)</span>
                        <div class="b" style="height:@(((item.Strain ?? 0) / 21 * 70).ToString("0.0", inv))%;--i:@i"></div>
                        <span>@(item.Date == Model.Today ? "Today" : Fmt.Weekday(item.Date))</span>
                    </div>
                }
            </div>
        </section>

        <section class="card rise" style="--d:4">
            <div class="card-head">
                <h2>Workouts</h2>
                <span class="side-note">@strain.Workouts.Count @(strain.Workouts.Count == 1 ? "session" : "sessions")</span>
            </div>
            @if (strain.Workouts.Count == 0)
            {
                <p class="muted" style="font-size:14px">No workouts recorded @(Model.IsToday ? "yet today" : "this day"). Walks and errands still count: every minute above half your maximum heart rate adds strain.</p>
            }
            @foreach (var workout in strain.Workouts)
            {
                <div class="workout">
                    <div class="top">
                        <span class="ico-chip str">@Icons.Get(Fmt.WorkoutIcon(workout.Kind))</span>
                        <div class="grow">
                            <b>@Fmt.WorkoutName(workout.Kind)</b>
                            <small>@Fmt.Clock(workout.StartedAt) · @workout.Minutes min</small>
                        </div>
                        <span class="pill @(workout == best ? "str" : "soft-str")">@Fmt.One(workout.Strain)</span>
                    </div>
                    @if (workout.HeartRates.Count > 1)
                    {
                        <svg class="wk-spark" viewBox="0 0 100 30" preserveAspectRatio="none" aria-hidden="true">
                            @{
                                var lo = workout.HeartRates.Min() - 5.0;
                                var hi = workout.HeartRates.Max() + 5.0;
                                var pts = string.Join(" ", workout.HeartRates.Select((b, i) => string.Create(inv, $"{i * 100.0 / (workout.HeartRates.Count - 1):0.0},{28 - (b - lo) / (hi - lo) * 26:0.0}")));
                            }
                            <polyline points="@pts" class="s-str" fill="none" stroke-width="2" vector-effect="non-scaling-stroke" stroke-linejoin="round" />
                        </svg>
                    }
                    <div class="meta">
                        @if (workout.DistanceKm is { } km) { <span><b>@km.ToString("0.0", inv)</b> km</span> }
                        @if (workout.AvgBpm is { } avg) { <span>avg <b>@avg</b> bpm</span> }
                        @if (workout.MaxBpm is { } max) { <span>max <b>@max</b> bpm</span> }
                        @if (workout.ActiveKcal is { } kcal) { <span><b>@kcal.ToString("0")</b> kcal</span> }
                        @if (workout.RecoveryOneMinute is { } hrr) { <span title="How far your heart rate fell in the first minute after the workout">recovery <b>−@hrr</b> bpm/min</span> }
                    </div>
                </div>
            }
        </section>
    </div>

    var recoveries = strain.RecoveryHistory;
    var latest = strain.Workouts.Where(static w => w.RecoveryOneMinute is not null).MaxBy(static w => w.MaxBpm ?? 0);
    <section class="card rise" style="--d:5" id="heart-recovery">
        <div class="card-head">
            <h2>Heart-rate recovery</h2>
            <span class="side-note">how far your heart rate falls after a workout · last 60 days</span>
        </div>
        @if (recoveries.Count == 0 && latest is null)
        {
            <p class="muted" style="font-size:14px">After each workout that gets your heart rate above 110 bpm, Kardia measures how many beats it drops in the first one and two minutes. It needs the Watch's heart rate in the minutes after you stop, so keep it on and end the workout on the Watch.</p>
        }
        else
        {
            var one = latest?.RecoveryOneMinute ?? recoveries.LastOrDefault(static r => r.OneMinute is not null)?.OneMinute;
            var two = latest?.RecoveryTwoMinutes ?? recoveries.LastOrDefault(static r => r.TwoMinutes is not null)?.TwoMinutes;
            <div class="tiles t3">
                <div class="tile"><span class="k">1 minute@(latest is not null ? " · " + Fmt.WorkoutName(latest.Kind).ToLowerInvariant() : "")</span><span class="v">@(one is { } o ? "−" + o : "—")<small> bpm</small></span><small class="dim">@Fmt.RecoveryWord(one)</small></div>
                <div class="tile"><span class="k">2 minutes</span><span class="v">@(two is { } t ? "−" + t : "—")<small> bpm</small></span></div>
                <div class="tile"><span class="k">60-day average</span><span class="v">@(strain.RecoveryAverage is { } a ? "−" + a.ToString("0", inv) : "—")<small> bpm</small></span></div>
            </div>
            @if (recoveries.Count(static r => r.OneMinute is not null) >= 2)
            {
                var points = recoveries.Where(static r => r.OneMinute is not null).Select(static r => new Charts.SeriesPoint(DateOnly.FromDateTime(r.StartedAt), r.OneMinute)).ToList();
                <div class="chart-wide">@Charts.Series(points, "ser-rec", "One-minute heart-rate recovery after each workout of the last 60 days", 0, 900, 160, dots: true)</div>
                <div class="chart-narrow">@Charts.Series(points, "ser-rec", "One-minute heart-rate recovery after each workout of the last 60 days", 0, 360, 150, dots: true)</div>
            }
            <p class="muted small-note">A bigger drop means a fitter heart that switches off quickly: over 30 bpm in the first minute is excellent, 20–30 good, 12–20 fair. It rises as your fitness builds, and dips when you're tired or getting ill.</p>
        }
    </section>
}
