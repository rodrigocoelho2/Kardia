@model Kardia.Website.Model.Days.DayPageModel
@{
    Layout = "_App";
    ViewData["Title"] = "Sleep";
    var day = Model.Day;
    var sleep = day.Sleep;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var tip = day.Coach.FirstOrDefault(static t => t.Area == CoachArea.Sleep);
    var stages = new[]
    {
        (Name: "Awake", Minutes: sleep.AwakeMinutes, Colour: "var(--awake)", Note: "Short wake-ups are normal"),
        (Name: "REM", Minutes: sleep.RemMinutes, Colour: "var(--rem)", Note: "Memory and mood"),
        (Name: "Light", Minutes: sleep.CoreMinutes, Colour: "var(--slp)", Note: "Most of the night"),
        (Name: "Deep", Minutes: sleep.DeepMinutes, Colour: "var(--slp-2)", Note: "Physical repair"),
    };
    var stageTotal = Math.Max(1, stages.Sum(static s => s.Minutes));
    var week = day.Recent.TakeLast(7).ToList();
    var weekMax = Math.Max(sleep.NeedMinutes, week.Select(static w => w.AsleepMinutes ?? 0).DefaultIfEmpty(0).Max()) * 1.1;
}

<partial name="_PageHead" model="Model" />
<partial name="_WeekStrip" model="Model" />

@if (!day.HasData || !sleep.HasNight)
{
    <partial name="_NoData" model="Model" />
}
else
{
    <div class="row">
        <section class="card hero tint-slp rise" style="--d:1">
            <div class="stars" aria-hidden="true">
                @for (var i = 0; i < 18; i++)
                {
                    <i style="left:@((i * 37 % 100).ToString(inv))%;top:@((i * 23 % 60 + 4).ToString(inv))%;animation-delay:@((i % 5) * 0.7)s"></i>
                }
            </div>
            <div class="ring-box">
                @Charts.Ring((sleep.Performance ?? 0) / 100.0, "slp")
                <div class="center">
                    <span class="big num">@(sleep.Performance?.ToString() ?? "—")<small>%</small></span>
                    <span class="lbl">Sleep</span>
                </div>
            </div>
            <h2 style="font-size:22px">@Fmt.Duration(sleep.AsleepMinutes) <span class="muted" style="font-weight:500">of @Fmt.Duration(sleep.NeedMinutes) needed</span></h2>
            <p class="lead">@Fmt.Clock(sleep.BedStart) → @Fmt.Clock(sleep.BedEnd) · @sleep.Cycles sleep cycles · @Fmt.Duration(sleep.InBedMinutes) in bed</p>
            <div class="tiles t3" style="align-self:stretch">
                <div class="tile center"><span class="k">Efficiency</span><span class="v">@(sleep.Efficiency?.ToString() ?? "—")<small>%</small></span></div>
                <div class="tile center"><span class="k">Consistency</span><span class="v">@(sleep.Consistency?.ToString() ?? "—")<small>%</small></span></div>
                <div class="tile center"><span class="k">Breathing</span><span class="v">@Fmt.One(sleep.RespiratoryRate)<small> rpm</small></span></div>
            </div>
        </section>

        <section class="card w2 tint-slp rise" style="--d:2">
            <div class="card-head">
                <h2>Stages</h2>
                <span class="side-note">@Fmt.Clock(sleep.BedStart) → @Fmt.Clock(sleep.BedEnd)</span>
            </div>
            <div class="chart-wide">@Charts.Hypnogram(sleep, 640)</div>
            <div class="chart-narrow">@Charts.Hypnogram(sleep)</div>
            <div class="stagebar" aria-hidden="true">
                @foreach (var stage in stages.Where(static s => s.Minutes > 0))
                {
                    <i style="flex:@stage.Minutes;background:@stage.Colour"></i>
                }
            </div>
            <div class="tiles t4">
                @foreach (var stage in stages)
                {
                    <div class="tile">
                        <span class="k"><span><i class="swatch" style="background:@stage.Colour"></i> @stage.Name</span><span class="dim">@((stage.Minutes * 100 / stageTotal).ToString(inv))%</span></span>
                        <span class="v">@Fmt.Duration(stage.Minutes)</span>
                        <small class="dim" style="font-size:11px">@stage.Note</small>
                    </div>
                }
            </div>
        </section>
    </div>

    <partial name="_AiCard" model='new AiCardModel(AiCoachTopic.Sleep, Model.IsToday ? null : Model.Date, "Explain my sleep")' />
    <div class="row">
        <section class="card rise" style="--d:3" id="tonight">
            <div class="card-head">
                <h2>Tonight</h2>
                @if (sleep.WakeAt is { } wake)
                {
                    <span class="side-note">to wake at @Fmt.Clock(wake)</span>
                }
            </div>
            <div>
                <span class="kicker">Be in bed by</span>
                <div class="bedtime" style="color:var(--slp-3)">@Fmt.Clock(sleep.Bedtime)</div>
            </div>
            <div class="need">
                <div><span>Baseline need</span><span>@Fmt.Duration(sleep.NeedBaseMinutes)</span></div>
                <div><span>+ today's strain</span><span>@Fmt.Duration(sleep.TonightStrainMinutes)</span></div>
                <div><span>+ sleep debt</span><span>@Fmt.Duration(sleep.TonightDebtMinutes)</span></div>
                <div class="total"><span>You need</span><span>@Fmt.Duration(sleep.TonightNeedMinutes)</span></div>
                @if (sleep.GoalPercent < 100)
                {
                    <div class="total"><span>@Fmt.GoalName(sleep.GoalPercent) · @sleep.GoalPercent%</span><span>@Fmt.Duration(sleep.TonightGoalMinutes)</span></div>
                }
            </div>
            @if (Model.IsToday)
            {
                <form method="post" action="/settings/sleep-goal" class="form" data-autosubmit>
                    @Html.AntiForgeryToken()
                    <span class="kicker">Sleep goal</span>
                    <div class="choices" style="grid-template-columns:repeat(3, minmax(0, 1fr))">
                        @foreach (var (percent, name) in new[] { (100, "Peak"), (85, "Perform"), (70, "Get by") })
                        {
                            <label class="choice">
                                <input type="radio" name="sleepGoalPercent" value="@percent" checked="@(sleep.GoalPercent == percent)" />
                                <b>@name</b><small>@percent% · @Fmt.Duration((int)(Math.Round(sleep.TonightNeedMinutes * percent / 100.0 / 5) * 5))</small>
                            </label>
                        }
                    </div>
                    <noscript><button class="btn ghost small" type="submit">Set goal</button></noscript>
                </form>
            }
            @if (tip is not null)
            {
                <p class="muted" style="font-size:13px;line-height:1.5">@tip.Text</p>
            }
        </section>

        <section class="card w2 rise" style="--d:4">
            <div class="card-head">
                <h2>Last 7 nights</h2>
                <div class="legend">
                    <span><i class="swatch" style="background:var(--slp)"></i>Asleep</span>
                    <span class="dim">need @Fmt.Duration(sleep.NeedMinutes)</span>
                </div>
            </div>
            <div class="week-bars slp">
                @for (var i = 0; i < week.Count; i++)
                {
                    var night = week[i];
                    var height = (night.AsleepMinutes ?? 0) / weekMax * 82;
                    <div class="col @(night.Date == Model.Date ? "on" : "")">
                        <span class="num" style="color:var(--text-2)">@(night.AsleepMinutes is { } a ? $"{a / 60}:{a % 60:00}" : "—")</span>
                        <div class="b" style="height:@(height.ToString("0.0", inv))%;--i:@i"></div>
                        <span>@(night.Date == Model.Today ? "Today" : Fmt.Weekday(night.Date))</span>
                    </div>
                }
            </div>
            <div class="tiles t3">
                @{
                    var asleep = week.Where(static w => w.AsleepMinutes is not null).Select(static w => w.AsleepMinutes!.Value).ToList();
                    var perf = week.Where(static w => w.SleepPerformance is not null).Select(static w => w.SleepPerformance!.Value).ToList();
                }
                <div class="tile"><span class="k">Average asleep</span><span class="v">@Fmt.Duration(asleep.Count > 0 ? (int)asleep.Average() : null)</span></div>
                <div class="tile"><span class="k">Average score</span><span class="v">@(perf.Count > 0 ? perf.Average().ToString("0") : "—")<small>%</small></span></div>
                <div class="tile"><span class="k">Sleep debt</span><span class="v" style="color:@(sleep.DebtMinutes > 60 ? "var(--mid)" : "var(--text)")">@Fmt.Duration(sleep.DebtMinutes)</span></div>
            </div>
        </section>
    </div>

    var light = day.Recent.TakeLast(7).ToList();
    var lightToday = day.Recent.LastOrDefault()?.DaylightMinutes;
    var lightKnown = light.Where(static d => d.DaylightMinutes is not null).Select(static d => d.DaylightMinutes!.Value).ToList();
    var lightMax = Math.Max(60, lightKnown.DefaultIfEmpty(0).Max()) * 1.1;
    <section class="card rise" style="--d:5" id="daylight">
        <div class="card-head">
            <h2>@Icons.Get("sun", "dl-ico")Time in daylight</h2>
            <span class="side-note">aim for 30 min, ideally in the morning</span>
        </div>
        @if (lightKnown.Count == 0)
        {
            <p class="muted" style="font-size:14px">Your Apple Watch measures the minutes you spend in daylight (watchOS 10 or later). Add <b>Time in Daylight</b> to the metrics Health Auto Export sends and it shows up here. Morning light sets your body clock, so you fall asleep earlier and more easily.</p>
        }
        else
        {
            <div class="row" style="margin:0">
                <div class="tiles t3 w2" style="align-self:center">
                    <div class="tile"><span class="k">@(Model.IsToday ? "Today" : "This day")</span><span class="v">@(lightToday?.ToString("0", inv) ?? "—")<small> min</small></span></div>
                    <div class="tile"><span class="k">7-day average</span><span class="v">@lightKnown.Average().ToString("0", inv)<small> min</small></span></div>
                    <div class="tile"><span class="k">Days over 30 min</span><span class="v">@lightKnown.Count(static m => m >= 30)<small>/@lightKnown.Count</small></span></div>
                </div>
                <div class="week-bars dl">
                    <span class="avg" style="bottom:calc(@((30 / lightMax * 82).ToString("0.0", inv))% + 24px)" title="30 minutes"></span>
                    @for (var i = 0; i < light.Count; i++)
                    {
                        var item = light[i];
                        <div class="col @(item.Date == Model.Date ? "on" : "")">
                            <span class="num" style="color:var(--text-2)">@(item.DaylightMinutes?.ToString("0", inv) ?? "—")</span>
                            <div class="b" style="height:@(((item.DaylightMinutes ?? 0) / lightMax * 82).ToString("0.0", inv))%;--i:@i"></div>
                            <span>@(item.Date == Model.Today ? "Today" : Fmt.Weekday(item.Date))</span>
                        </div>
                    }
                </div>
            </div>
            <p class="muted small-note">Daylight in the first hours after waking moves your body clock earlier: you get sleepy at a sensible time and wake up more easily. Even a cloudy day outside is many times brighter than indoors.</p>
        }
    </section>
}
