@model AppPageModel
@{
    Layout = "_App";
    ViewData["Title"] = "Breathe";
    var patterns = new[]
    {
        ("coherent", "Coherent", "5.5 in · 5.5 out", "About 5½ breaths a minute: the pace that raises HRV the most. Good any time.", "5.5,0,5.5,0"),
        ("box", "Box", "4 in · 4 hold · 4 out · 4 hold", "Used by athletes and the military to steady the mind before something hard.", "4,4,4,4"),
        ("relax", "4-7-8", "4 in · 7 hold · 8 out", "A long, slow breath out switches the body to rest. Good before bed.", "4,7,8,0"),
    };
}

<header class="head rise">
    <div>
        <div class="eyebrow">Guided breathing · slows your heart and lifts HRV</div>
        <h1>Breathe</h1>
    </div>
    <div class="head-acts">
        <a class="btn ghost small" href="/stress">@Icons.Get("stress")Stress today</a>
    </div>
</header>

<div class="row">
    <section class="card w2 breathe rise" style="--d:1" data-breathe data-date="@Fmt.Iso(Model.Today)">
        <div class="br-stage" aria-live="polite">
            <div class="br-orb" data-orb aria-hidden="true"><i></i><i></i><i></i></div>
            <div class="br-text">
                <b data-phase>Ready</b>
                <span class="num" data-count></span>
            </div>
        </div>
        <div class="br-time"><span class="num" data-left>1:00</span> <small class="dim" data-cycles></small></div>
        <div class="br-controls">
            <nav class="tabs-seg" aria-label="Length">
                @foreach (var minutes in new[] { 1, 3, 5 })
                {
                    <button type="button" class="seg" data-minutes="@minutes" aria-pressed="@(minutes == 1 ? "true" : "false")">@minutes min</button>
                }
            </nav>
            <button type="button" class="btn rec" data-start>@Icons.Get("wind")<span data-label>Start</span></button>
        </div>
        <div class="br-done" data-done hidden>
            <p><b>Nicely done.</b> <span data-done-text></span></p>
            <button type="button" class="btn ghost small" data-log>@Icons.Get("journal")<span data-label>Log meditation in the journal</span></button>
        </div>
    </section>

    <section class="card rise" style="--d:2">
        <div class="card-head">
            <h2>Pattern</h2>
        </div>
        <div class="br-patterns" role="radiogroup" aria-label="Breathing pattern">
            @foreach (var (key, name, rhythm, text, timing) in patterns)
            {
                <button type="button" class="br-pattern" role="radio" data-pattern="@key" data-timing="@timing" aria-checked="@(key == "coherent" ? "true" : "false")">
                    <span class="top"><b>@name</b><small class="num">@rhythm</small></span>
                    <small>@text</small>
                </button>
            }
        </div>
        <p class="muted small-note">Breathe in through your nose, out slowly through your mouth. Stop if you feel light-headed. A few minutes in the evening shows up in the night's HRV.</p>
    </section>
</div>

@section Scripts {
    <script src="~/js/breathe.js" asp-append-version="true"></script>
}
