    <ProjectReference Include="..\Kardia.Sdk\Kardia.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kardia.UnitTest" />
  </ItemGroup>

</Project>
