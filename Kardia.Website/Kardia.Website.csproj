       and is the public address Health Auto Export / the iOS Shortcut send Apple Health data to (/api/sync). -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
