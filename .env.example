# Copy this file to ".env" (next to docker-compose.yml) and fill it in.
# .env holds secrets: don't share it or put it in git.
# No spaces around "=". If a value has # or spaces, wrap it in single quotes: 'a#b c'.

# ---------- Required ----------

# SQL Server's sa password: at least 8 characters with three of upper case, lower case, digits and symbols
# (avoid ; and quotes).
SQL_SA_PASSWORD=Change-Me-2026!

# Internal key between the website and the WebApi. Make up a long random string
# (e.g. in PowerShell:  -join ((48..57)+(97..122) | Get-Random -Count 40 | % {[char]$_}) ).
KARDIA_API_KEY=change-this-to-a-long-random-key

# Asked for only when creating the FIRST account (the admin), so nobody else on the network can create it before you.
KARDIA_SETUP_KEY=change-this

# ---------- Sign in with Discord (optional) ----------

# One Discord application can serve all your apps: https://discord.com/developers/applications → your app → OAuth2.
# Copy the Client ID and (Reset Secret) the Client Secret here, and under Redirects add this app's address followed by
# /signin-discord, e.g. https://kardia.prometheus-nas.com/signin-discord (one line per address you open Kardia at).
# Already have an account? Sign in with your password and press "Link Discord" in Settings. Someone new can sign up
# with Discord (while KARDIA_ALLOW_REGISTRATION is on).
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# ---------- Optional ----------

# The public address of Kardia (through Nginx Proxy Manager), shown in Settings › Apple Watch for Health Auto Export.
# KARDIA_PUBLIC_URL=https://kardia.example.com

# false = after the first account, nobody can create one from the sign-in page.
# KARDIA_ALLOW_REGISTRATION=true

# Days start at midnight in this time zone.
# TIME_ZONE=Europe/Lisbon

# KARDIA_PORT=5090
# SQL_PORT=1435
# SQL_MEMORY_LIMIT_MB=1024
# SQL_CPUS=2
# KARDIA_CPUS=1.5
# KARDIA_WEBAPI_MEMORY=1g
# KARDIA_WEBSITE_MEMORY=512m

# ---------- Notifications ----------

# Push notifications need Kardia on HTTPS (your Cloudflare / Nginx Proxy Manager address). On iPhone, add Kardia to
# the Home Screen from Safari first, open it from there, then Settings › Notifications › Turn on.
# KARDIA_PUSH_ENABLED=true
# A contact the push services (Apple, Google…) see: mailto:you@example.com or your https address.
# KARDIA_PUSH_SUBJECT=https://kardia.example.com

# ---------- AI coach (optional) ----------

# Claude (https://console.anthropic.com → API keys):
# KARDIA_AI_PROVIDER=anthropic
# KARDIA_AI_API_KEY=sk-ant-...
# KARDIA_AI_MODEL=claude-haiku-5-5
#
# Or Gemini (https://aistudio.google.com → Get API key):
# KARDIA_AI_PROVIDER=gemini
# KARDIA_AI_API_KEY=...
# KARDIA_AI_MODEL=gemini-3.8-flash
#
# Or a local model with Ollama (nothing leaves your network), or any OpenAI-compatible API:
# KARDIA_AI_PROVIDER=openai
# KARDIA_AI_BASE_URL=http://192.168.1.10:11434/v1
# KARDIA_AI_MODEL=llama3.1:8b
#
# The language the report is written in (English by default).
# KARDIA_AI_LANGUAGE=English

# true = sample data in memory, no SQL Server needed (sign in as demo / kardia-demo).
# KARDIA_DEMO_MODE=false
